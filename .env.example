# ==============================================
# Indian Stock Market Trading Bot - Configuration
# ==============================================

# Application Environment (development / production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# Default to SQLite for seamless zero-config local development,
# or set to PostgreSQL for production/Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tradebot
DATABASE_URL=sqlite+aiosqlite:///./tradebot.db

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Indian Stock Market Paper Trading Bot

# Risk Management Defaults
DEFAULT_INITIAL_CAPITAL=100000.0
MAX_CAPITAL_PER_TRADE_PCT=0.20
DEFAULT_STOP_LOSS_PCT=0.02
DEFAULT_TAKE_PROFIT_PCT=0.05
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=0.03

# Market Data Source Configuration
# Options:
#   'hybrid'  - Yahoo Finance Fast Quotes + Mathematical Simulated F&O (Default, Zero-Config)
#   'mock'    - 100% Offline Synthetic Ticks & Option Chain (Labeled 'DEMO DATA')
#   'angel_one' - Angel One SmartAPI (Requires Angel One trading account)
#   'kite'    - Zerodha Kite Connect (Requires paid API subscription)
LIVE_DATA_PROVIDER=hybrid
MARKET_DATA_PROVIDER=yfinance
DEFAULT_EXCHANGE=NSE

# Optional: Angel One SmartAPI Credentials (FREE API for Angel One accounts)
# ANGEL_ONE_API_KEY=your_smartapi_key_here
# ANGEL_ONE_CLIENT_CODE=your_client_code
# ANGEL_ONE_PIN=your_mpin
# ANGEL_ONE_TOTP_SECRET=your_totp_qr_secret_key

# Optional: Zerodha Kite Connect Credentials (Paid ₹2000/mo API subscription)
# KITE_API_KEY=your_kite_api_key
# KITE_API_SECRET=your_kite_api_secret
# KITE_ACCESS_TOKEN=your_generated_access_token